<% layout('layouts/boilerplate') -%>

<div class="row mt-4 mb-5">
    <div class="col-md-8 offset-md-2 col-12">
        <div class="card form-card shadow border-0 rounded-4 p-4 p-md-5">
            <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
                <div class="form-icon-circle me-3">
                    <i class="fa-solid fa-house-chimney-medical text-danger fs-4"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">Create a New Listing</h3>
                    <p class="text-muted mb-0 small">Share your beautiful space with travelers around the world</p>
                </div>
            </div>
            
            <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="title" class="form-label fw-semibold">
                        <i class="fa-solid fa-heading me-1 text-muted"></i> Title
                    </label>
                    <input 
                        id="title"
                        name="listing[title]" 
                        placeholder="e.g. Luxury Beachside Villa with Pool" 
                        class="form-control form-control-lg rounded-3" 
                        required
                    />
                    <div class="invalid-feedback">Please enter a catchy title.</div> 
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label fw-semibold">
                        <i class="fa-solid fa-align-left me-1 text-muted"></i> Description
                    </label>
                    <textarea 
                        id="description"
                        name="listing[description]" 
                        placeholder="Describe your place, views, amenities, vibe..." 
                        rows="4"
                        class="form-control rounded-3" 
                        required
                    ></textarea>
                    <div class="invalid-feedback">Please enter a short description.</div> 
                </div>

                <div class="mb-3">
                    <label for="image" class="form-label fw-semibold">
                        <i class="fa-solid fa-image me-1 text-muted"></i> Listing Image
                    </label>
                    <div class="input-group">
                        <input 
                            type="file"
                            id="image"
                            name="listing[image]" 
                            class="form-control rounded-3"
                            accept="image/*"
                        />
                    </div>
                    <div id="imagePreviewWrap" class="image-preview-wrap mt-3 d-none">
                        <img id="imagePreview" class="image-preview" alt="Selected listing preview" />
                    </div>
                    <div class="form-text text-muted">Upload a photo, or leave empty to use a scenic default travel photo.</div>
                </div>

                <div class="row">
                    <div class="mb-3 col-md-5">
                        <label for="price" class="form-label fw-semibold">
                            <i class="fa-solid fa-indian-rupee-sign me-1 text-muted"></i> Price (/ night)
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">&#8377;</span>
                            <input 
                                id="price"
                                name="listing[price]" 
                                placeholder="2500" 
                                type="number"
                                class="form-control rounded-end-3 border-start-0" 
                                required
                            />
                        </div>
                        <div class="invalid-feedback">Please enter a valid price.</div> 
                    </div>
                    
                    <div class="mb-3 col-md-7">
                        <label for="country" class="form-label fw-semibold">
                            <i class="fa-solid fa-earth-americas me-1 text-muted"></i> Country
                        </label>
                        <input 
                            id="country"
                            name="listing[country]" 
                            placeholder="e.g. India" 
                            class="form-control rounded-3" 
                            required
                        />
                        <div class="invalid-feedback">Please enter a country.</div> 
                    </div>  
                </div>

                <div class="mb-4">
                    <label for="location" class="form-label fw-semibold">
                        <i class="fa-solid fa-location-dot me-1 text-muted"></i> Location (City / State)
                    </label>
                    <input 
                        id="location"
                        name="listing[location]"  
                        placeholder="e.g. Jaipur, Rajasthan" 
                        type="text" 
                        class="form-control rounded-3" 
                        required
                    />
                    <div class="invalid-feedback">Please enter a location.</div> 
                </div>

                <div class="d-flex gap-3 pt-2">
                    <button class="btn btn-dark add-btn px-4 py-2 rounded-3 fw-semibold shadow-sm">
                        <i class="fa-solid fa-plus me-1"></i> Add Listing
                    </button>
                    <a href="/" class="btn btn-outline-secondary px-4 py-2 rounded-3">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>


<script>
  document.addEventListener("DOMContentLoaded", () => {
    const imageInput = document.getElementById("image");
    const previewWrap = document.getElementById("imagePreviewWrap");
    const preview = document.getElementById("imagePreview");

    if (imageInput && previewWrap && preview) {
      imageInput.addEventListener("change", () => {
        const file = imageInput.files && imageInput.files[0];
        if (!file) {
          previewWrap.classList.add("d-none");
          return;
        }
        preview.src = URL.createObjectURL(file);
        previewWrap.classList.remove("d-none");
      });
    }
  });
</script>
