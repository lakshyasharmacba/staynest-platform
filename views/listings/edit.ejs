
<% layout('layouts/boilerplate') -%>
<div class="row mt-4 mb-5">
  <div class="col-md-8 offset-md-2 col-12">
    <div class="card form-card shadow border-0 rounded-4 p-4 p-md-5">
      <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
        <div class="form-icon-circle me-3">
          <i class="fa-solid fa-pen-to-square text-danger fs-4"></i>
        </div>
        <div>
          <h3 class="fw-bold mb-0">Edit Your Listing</h3>
          <p class="text-muted mb-0 small">Update your place details, pricing, and imagery</p>
        </div>
      </div>
      
      <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
        
        <div class="mb-3">
          <label for="title" class="form-label fw-semibold">
            <i class="fa-solid fa-heading me-1 text-muted"></i> Title
          </label>
          <input 
            name="listing[title]" 
            id="title" 
            placeholder="Enter title"  
            value="<%= listing.title %>" 
            type="text"  
            class="form-control form-control-lg rounded-3" 
            required 
          />
          <div class="invalid-feedback">Please enter a valid title.</div> 
        </div>

        <div class="mb-3">
          <label for="description" class="form-label fw-semibold">
            <i class="fa-solid fa-align-left me-1 text-muted"></i> Description
          </label>  
          <textarea 
            name="listing[description]"  
            id="description" 
            placeholder="Enter description" 
            rows="4"
            class="form-control rounded-3" 
            required
          ><%= listing.description %></textarea>
          <div class="invalid-feedback">Please enter a valid description.</div> 
        </div>

        <% if (originalImageUrl) { %>
          <div class="mb-3">
            <label class="form-label fw-semibold">
              <i class="fa-solid fa-image me-1 text-muted"></i> Current Image Preview
            </label>
            <div class="card overflow-hidden shadow-sm rounded-3 border-0" style="max-width: 250px;">
              <img src="<%= originalImageUrl %>" class="img-fluid rounded-3" alt="Current Image"/>
            </div>
          </div>
        <% } %>

        <div class="mb-3">
          <label for="image" class="form-label fw-semibold">
            <i class="fa-solid fa-cloud-arrow-up me-1 text-muted"></i> Upload New Image (Optional)
          </label>
          <input 
            name="listing[image]"  
            id="image" 
            class="form-control rounded-3" 
            type="file"
            accept="image/*"
          />
          <div id="imagePreviewWrap" class="image-preview-wrap mt-3 d-none">
            <img id="imagePreview" class="image-preview" alt="Selected listing preview" />
          </div>
          <div class="form-text text-muted">Leave empty if you want to keep the current image.</div>
        </div>

        <div class="row">
          <div class="mb-3 col-md-5">
            <label for="price" class="form-label fw-semibold">
              <i class="fa-solid fa-indian-rupee-sign me-1 text-muted"></i> Price (/ night)
            </label>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0">&#8377;</span>
              <input 
                name="listing[price]"  
                id="price" 
                placeholder="1200" 
                class="form-control rounded-end-3 border-start-0" 
                value="<%= listing.price %>" 
                type="number" 
                required 
              />
            </div>
            <div class="invalid-feedback">Please enter a valid price.</div> 
          </div>

          <div class="mb-3 col-md-7">
            <label for="country" class="form-label fw-semibold">
              <i class="fa-solid fa-earth-americas me-1 text-muted"></i> Country
            </label>
            <input 
              name="listing[country]"  
              id="country" 
              placeholder="e.g. India" 
              class="form-control rounded-3" 
              value="<%= listing.country %>" 
              type="text" 
              required
            />
            <div class="invalid-feedback">Please enter a valid country.</div>
          </div>
        </div>

        <div class="mb-4">
          <label for="location" class="form-label fw-semibold">
            <i class="fa-solid fa-location-dot me-1 text-muted"></i> Location (City / State)
          </label>
          <input 
            name="listing[location]"  
            id="location" 
            placeholder="e.g. Jaipur, Rajasthan" 
            class="form-control rounded-3" 
            value="<%= listing.location %>" 
            type="text" 
            required 
          />
          <div class="invalid-feedback">Please enter a valid location.</div> 
        </div>

        <div class="d-flex gap-3 pt-2">
          <button class="btn btn-dark edit-btn px-4 py-2 rounded-3 fw-semibold shadow-sm">
            <i class="fa-solid fa-check me-1"></i> Update Listing
          </button>
          <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary px-4 py-2 rounded-3">
            Cancel
          </a>
        </div>
      </form>
    </div>
  </div>
</div>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const imageInput = document.getElementById("image");
    const previewWrap = document.getElementById("imagePreviewWrap");
    const preview = document.getElementById("imagePreview");

    if (imageInput && previewWrap && preview) {
      imageInput.addEventListener("change", () => {
        const file = imageInput.files && imageInput.files[0];
        if (!file) {
          previewWrap.classList.add("d-none");
          return;
        }
        preview.src = URL.createObjectURL(file);
        previewWrap.classList.remove("d-none");
      });
    }
  });
</script>
